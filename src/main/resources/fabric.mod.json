    "client": ["ru.guithemes.GuiThemesClient"]
  },
  "mixins": ["guithemes.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
